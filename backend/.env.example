# Copy to .env and fill in. Never commit the real .env.
GOOGLE_API_KEY=
TAVILY_API_KEY=
# CORS: the frontend origin allowed to call this API, as scheme://host[:port]
# with no trailing slash (the app refuses to start otherwise)
FRONTEND_ORIGIN=http://localhost:3000

# Rate limits on POST /eligibility, kept in process memory (reset on restart).
# Each accepted check costs model credits; raise these for local testing if needed
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=20
RATE_LIMIT_GLOBAL_PER_DAY=100
# Read by uvicorn itself, not the app: which proxies may set the client IP. Behind Railway
# use *, since its edge rewrites X-Forwarded-For with the real client first. Unset means
# every visitor behind a proxy shares one per-IP limit. Leave unset for local dev.
# FORWARDED_ALLOW_IPS=*

# ChromaDB connection (defaults match the Docker Compose host-port mapping;
# the backend service itself overrides these to the in-network address)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=scholarship_programs
# Deployed single-service setup only: run Chroma embedded on this path (the service's volume)
# instead of connecting to a Chroma server. When set, CHROMA_HOST and CHROMA_PORT are ignored.
# CHROMA_PERSIST_PATH=/data/chroma

# Agent tuning (defaults are usually fine)
AGENT_MODEL=google:gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
RETRIEVAL_TOP_K=5
LLM_TIMEOUT_SECONDS=20.0
CHROMA_TIMEOUT_SECONDS=5.0
WEB_SEARCH_TIMEOUT_SECONDS=10.0
AGENT_RUN_TIMEOUT_SECONDS=45.0

# Traces and metrics: unset means off. Docker Compose sets the in-network collector
# address; uncomment to export from a host-run uvicorn to the Compose collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORT_TIMEOUT_SECONDS=5.0
# Metric export interval in milliseconds (SDK default 60000); lower it for local checks
# OTEL_METRIC_EXPORT_INTERVAL=5000

# Knowledge ingestion (python -m app.ingestion); paths are relative to backend/
INGESTION_SOURCE_DIR=data/programs
INGESTION_STATUS_PATH=data/ingestion-status.json
INGESTION_CHUNK_MAX_CHARS=1200
INGESTION_TIMEOUT_SECONDS=60.0

# Evaluation (python -m app.evaluation); paths are relative to backend/
EVALUATION_PROFILES_PATH=data/evaluation/profiles.json
EVALUATION_RUNS_PATH=data/evaluation-runs.jsonl
# Attempts per profile. 3 measures consistency; 1 is a quick smoke run
EVALUATION_REPEATS=3
# Seconds to wait between attempts. Raise it if the model provider rate-limits a full run
EVALUATION_ATTEMPT_DELAY_SECONDS=0

# Operations view (/ops). Pick a long random value and set the same one as the
# frontend's OPS_API_TOKEN. Unset disables GET /ops/summary.
OPS_API_TOKEN=
# Traffic trends on /ops. From Grafana Cloud portal > your stack > Prometheus > Details:
# the query URL (ends in /api/prom) and the numeric user ID. The token needs only the
# metrics:read scope; it is separate from the OTLP push credentials in infra/.env.
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USER=
GRAFANA_PROMETHEUS_TOKEN=
GRAFANA_QUERY_TIMEOUT_SECONDS=5.0
