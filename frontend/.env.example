# Copy to .env.local and adjust if the backend isn't on its default dev port.
# Base URL of the FastAPI backend (see backend/AGENTS.md / uvicorn app.main:app --reload).
# Public and inlined into the browser bundle at build time, so changing it needs a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Operations view (/ops). The browser asks for this username and password;
# /ops returns 503 while either is unset.
OPS_USERNAME=
OPS_PASSWORD=
# Server-side only (no NEXT_PUBLIC_ prefix): must equal the backend's OPS_API_TOKEN.
OPS_API_TOKEN=
